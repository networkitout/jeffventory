generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite does not support Prisma enums. Allowed values live in src/lib/constants.ts:
//   status:    IN_STOCK | LISTED | SOLD | ARCHIVED
//   condition: NEW | LIKE_NEW | USED | FOR_PARTS
model Item {
  id            String    @id @default(cuid())
  sku           String    @unique // internal code, encoded in printed QR labels (e.g. JV-8F3KQ2)
  name          String
  description   String?
  quantity      Int       @default(1)
  upc           String?   // scanned UPC/EAN from the product packaging
  condition     String    @default("USED")
  status        String    @default("IN_STOCK")
  purchasePrice Float?
  listPrice     Float?
  ebayUrl       String?
  notes         String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([upc])
  @@index([status])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Location {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}
