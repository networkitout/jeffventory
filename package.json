{
  "name": "jeffventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:serve": "tsx scripts/e2e-server.ts",
    "test:docker": "node scripts/test-compose.mjs",
    "auth:manage": "tsx scripts/manage-users.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.15",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@zxing/browser": "^0.2.1",
    "better-auth": "1.7.15",
    "bwip-js": "^4.11.4",
    "dotenv": "^17.4.2",
    "nanoid": "^6.0.1",
    "next": "16.4.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
