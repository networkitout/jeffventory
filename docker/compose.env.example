# Copy to .env.docker. Replace 127.0.0.1 with the server's private LAN IP
# to allow other trusted devices to connect.
JEFFVENTORY_BIND_ADDRESS=127.0.0.1
JEFFVENTORY_PORT=3000

# Optional private HTTPS. Use the same LAN IP, or a locally resolvable hostname.
# Do not include a scheme or port in JEFFVENTORY_HOSTNAME.
JEFFVENTORY_HOSTNAME=localhost
JEFFVENTORY_HTTPS_PORT=8443

# Required: generate with openssl rand -hex 32. Keep private and back up securely.
BETTER_AUTH_SECRET=
# For HTTPS use a stable DNS hostname, e.g. https://inventory.home.arpa:8443.
# Passkeys do not support IP-address relying-party IDs. Open this exact URL.
BETTER_AUTH_URL=http://localhost:3000
